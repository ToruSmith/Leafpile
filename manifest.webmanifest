{
  "name": "Leafpile 頁堆",
  "short_name": "Leafpile",
  "description": "One folder: notes by day, slides on stage. / 一個資料夾，平常是筆記，上台是簡報。",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3eee4",
  "theme_color": "#f3eee4",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
